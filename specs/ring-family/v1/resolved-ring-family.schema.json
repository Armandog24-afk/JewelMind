{
  "$defs": {
    "RingFamilyDerivation": {
      "additionalProperties": false,
      "description": "One JDL path a family wrote, and what it was computed from.\n\nTHE PROVENANCE RECORD. Without it a reader can see that `setting.basketHeight`\nis 4.2 and not that the elevated variant derived it from 3.5 — which is the\ndifference between a parametric system and a system that happens to have\nchanged a number.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "value": {
          "title": "Value"
        },
        "sourceParameters": {
          "items": {
            "type": "string"
          },
          "title": "Sourceparameters",
          "type": "array"
        },
        "relation": {
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "path",
        "value",
        "sourceParameters",
        "relation"
      ],
      "title": "RingFamilyDerivation",
      "type": "object"
    },
    "RingFamilyParams": {
      "additionalProperties": false,
      "description": "The family's parametric knobs.\n\nONE FLAT MODEL, NOT A DISCRIMINATED UNION, and for the reason Sprint 26 and\nSprint 27 both recorded: a discriminated union at the JDL layer cannot be\nreached by a dotted-path patch, which is exactly the defect that stopped\nDesigner creating a pavé. A flat model keeps every route — a UI control, a\nspoken request, a hand-written document — able to set one value.\n\nEVERY PARAMETER IS A MODULATION OR A DIMENSION, never a replacement. A\nfactor multiplies what the document already states, so `ring.size`,\n`band.width` and `stone.diameter` keep driving the geometry and the family\nmodulates what they produce. That is what makes the system parametric rather\nthan a set of stored values.\n\nA parameter a variant does not read is reported as INFORMATION by\n`JM-RINGFAM-003` rather than silently ignored, and a test asserts every\nfield here is read by at least one variant — a field nothing reads would be\nthe silently ignored parameter ARRANGE-GOV-011 forbids.",
      "properties": {
        "headHeightFactor": {
          "default": 1.0,
          "exclusiveMinimum": 0.05,
          "maximum": 5.0,
          "title": "Headheightfactor",
          "type": "number"
        },
        "shoulderSpanDeg": {
          "default": 50.0,
          "exclusiveMinimum": 1.0,
          "maximum": 90.0,
          "title": "Shoulderspandeg",
          "type": "number"
        },
        "shoulderTopWidthFactor": {
          "default": 0.85,
          "exclusiveMinimum": 0.05,
          "maximum": 1.0,
          "title": "Shouldertopwidthfactor",
          "type": "number"
        },
        "shoulderTopThicknessFactor": {
          "default": 0.85,
          "exclusiveMinimum": 0.05,
          "maximum": 1.0,
          "title": "Shouldertopthicknessfactor",
          "type": "number"
        },
        "splitSeparationMm": {
          "default": 1.2,
          "exclusiveMinimum": 0.0,
          "maximum": 20.0,
          "title": "Splitseparationmm",
          "type": "number"
        },
        "splitJoinSpanDeg": {
          "default": 200.0,
          "exclusiveMinimum": 10.0,
          "maximum": 350.0,
          "title": "Splitjoinspandeg",
          "type": "number"
        },
        "bypassSeparationMm": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 20.0,
          "title": "Bypassseparationmm",
          "type": "number"
        },
        "bypassOverlapDeg": {
          "default": 60.0,
          "exclusiveMinimum": 5.0,
          "maximum": 180.0,
          "title": "Bypassoverlapdeg",
          "type": "number"
        },
        "signetTableLengthMm": {
          "default": 11.0,
          "exclusiveMinimum": 0.1,
          "maximum": 60.0,
          "title": "Signettablelengthmm",
          "type": "number"
        },
        "signetTableWidthMm": {
          "default": 9.0,
          "exclusiveMinimum": 0.1,
          "maximum": 60.0,
          "title": "Signettablewidthmm",
          "type": "number"
        },
        "signetTableHeightMm": {
          "default": 2.0,
          "exclusiveMinimum": 0.1,
          "maximum": 30.0,
          "title": "Signettableheightmm",
          "type": "number"
        },
        "sideStoneScale": {
          "default": 0.55,
          "exclusiveMinimum": 0.01,
          "maximum": 10.0,
          "title": "Sidestonescale",
          "type": "number"
        },
        "sideSpacingMm": {
          "default": 5.0,
          "exclusiveMinimum": 0.0,
          "maximum": 40.0,
          "title": "Sidespacingmm",
          "type": "number"
        },
        "sideGraduationFactor": {
          "default": 0.8,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.05,
          "title": "Sidegraduationfactor",
          "type": "number"
        },
        "haloStoneCount": {
          "default": 16,
          "maximum": 96,
          "minimum": 3,
          "title": "Halostonecount",
          "type": "integer"
        },
        "haloRadiusFactor": {
          "default": 1.05,
          "exclusiveMinimum": 0.1,
          "maximum": 10.0,
          "title": "Haloradiusfactor",
          "type": "number"
        },
        "haloStoneScale": {
          "default": 0.22,
          "exclusiveMinimum": 0.01,
          "maximum": 10.0,
          "title": "Halostonescale",
          "type": "number"
        },
        "paveShoulders": {
          "default": false,
          "title": "Paveshoulders",
          "type": "boolean"
        },
        "paveSpanDeg": {
          "default": 90.0,
          "exclusiveMinimum": 1.0,
          "maximum": 360.0,
          "title": "Pavespandeg",
          "type": "number"
        },
        "paveStoneScale": {
          "default": 0.1,
          "exclusiveMinimum": 0.001,
          "maximum": 10.0,
          "title": "Pavestonescale",
          "type": "number"
        },
        "eternityPitchMm": {
          "default": 1.6,
          "exclusiveMinimum": 0.05,
          "maximum": 50.0,
          "title": "Eternitypitchmm",
          "type": "number"
        },
        "eternityStoneCount": {
          "default": 12,
          "maximum": 200,
          "minimum": 1,
          "title": "Eternitystonecount",
          "type": "integer"
        },
        "eternityStoneSpacingMm": {
          "default": 1.6,
          "exclusiveMinimum": 0.05,
          "maximum": 50.0,
          "title": "Eternitystonespacingmm",
          "type": "number"
        },
        "eternityStoneScale": {
          "default": 0.18,
          "exclusiveMinimum": 0.001,
          "maximum": 10.0,
          "title": "Eternitystonescale",
          "type": "number"
        },
        "eternityStartAngleDeg": {
          "default": 0.0,
          "maximum": 360.0,
          "minimum": -360.0,
          "title": "Eternitystartangledeg",
          "type": "number"
        },
        "eternityRetention": {
          "default": "BEAD",
          "enum": [
            "NONE",
            "BEAD",
            "SHARED_BEAD",
            "MICRO_PRONG"
          ],
          "title": "Eternityretention",
          "type": "string"
        },
        "clusterStoneCount": {
          "default": 8,
          "maximum": 24,
          "minimum": 1,
          "title": "Clusterstonecount",
          "type": "integer"
        },
        "clusterStoneScale": {
          "default": 0.4,
          "exclusiveMinimum": 0.01,
          "maximum": 10.0,
          "title": "Clusterstonescale",
          "type": "number"
        },
        "clusterRadiusMm": {
          "default": 4.0,
          "exclusiveMinimum": 0.0,
          "maximum": 40.0,
          "title": "Clusterradiusmm",
          "type": "number"
        },
        "toiEtMoiSecondScale": {
          "default": 1.0,
          "exclusiveMinimum": 0.01,
          "maximum": 10.0,
          "title": "Toietmoisecondscale",
          "type": "number"
        },
        "toiEtMoiSeparationMm": {
          "default": 5.0,
          "exclusiveMinimum": 0.0,
          "maximum": 40.0,
          "title": "Toietmoiseparationmm",
          "type": "number"
        },
        "toiEtMoiOrientationDeg": {
          "default": 30.0,
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "Toietmoiorientationdeg",
          "type": "number"
        },
        "symmetry": {
          "default": "SYMMETRIC",
          "enum": [
            "SYMMETRIC",
            "ASYMMETRIC"
          ],
          "title": "Symmetry",
          "type": "string"
        }
      },
      "title": "RingFamilyParams",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The family a design actually uses, after resolution.",
