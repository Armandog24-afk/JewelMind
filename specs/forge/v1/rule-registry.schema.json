{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jewelmind.example/specs/forge/v1/rule-registry.schema.json",
  "title": "Forge Rule Registry v1",
  "description": "Structural schema for the aggregate Forge Rule Registry — a list of rule summaries, each cross-referencing the full rule.schema.json shape. See docs/bible/06-forge/109-rule-registry.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "generatedFrom", "rules"],
  "properties": {
    "registryVersion": { "type": "string" },
    "generatedFrom": {
      "type": "string",
      "description": "What this registry snapshot was generated by inspecting, e.g. 'backend/jewelmind/validation/rules.py + engine.py, Sprint 4'."
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/RuleSummary" }
    }
  },
  "$defs": {
    "RuleSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId", "currentVersion", "active", "lifecycleState",
        "classification", "stage", "professionalValidationStatus", "source"
      ],
      "properties": {
        "ruleId": { "type": "string" },
        "currentVersion": { "type": "string" },
        "active": { "type": "boolean" },
        "lifecycleState": {
          "enum": ["PROPOSED", "EXPERIMENTAL", "PRELIMINARY", "UNDER_REVIEW", "VALIDATED", "ACCEPTED", "DEPRECATED", "REJECTED"]
        },
        "classification": {
          "enum": [
            "SCHEMA_INTEGRITY", "SEMANTIC_COMPATIBILITY", "DOMAIN_INVARIANT",
            "GEOMETRY_PRECONDITION", "GEOMETRY_INSPECTION", "PROTOTYPE_HEURISTIC",
            "MANUFACTURING_CONTEXT", "EXPORT_PRECONDITION", "PROFESSIONAL_CANDIDATE",
            "PROFESSIONALLY_VALIDATED", "SYSTEM_SAFETY"
          ]
        },
        "stage": {
          "enum": ["FORGE-0", "FORGE-1", "FORGE-2", "FORGE-3", "FORGE-4", "FORGE-5", "FORGE-6", "FORGE-7", "FORGE-8", "FORGE-9"]
        },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jewelryCategories": { "type": "array", "items": { "type": "string" } },
            "styles": { "type": "array", "items": { "type": "string" } },
            "materials": { "type": "array", "items": { "type": "string" } },
            "manufacturingMethods": { "type": "array", "items": { "type": "string" } }
          }
        },
        "professionalValidationStatus": {
          "enum": ["not_required", "preliminary", "required", "validated"]
        },
        "source": {
          "type": "string",
          "description": "Repository-relative code location, e.g. 'backend/jewelmind/validation/engine.py::_band_rules'."
        },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "tests": { "type": "array", "items": { "type": "string" } },
        "deprecatedVersions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
