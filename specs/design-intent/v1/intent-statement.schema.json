{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jewelmind.example/specs/design-intent/v1/intent-statement.schema.json",
  "title": "Design Intent Statement v1",
  "description": "One structured aesthetic descriptor — never a numeric geometry value. See docs/bible/13-design-intent/332-intent-domain-model.md and 349-deterministic-resolution-policy.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["intentId", "target", "concept", "value", "provenance", "confidenceClass", "sourceText", "resolutionStatus"],
  "properties": {
    "intentId": { "type": "string" },
    "target": {
      "enum": ["JEWELRY_PRODUCT", "RING", "BAND", "STONE", "SETTING", "PRONGS", "BASKET", "MATERIAL_APPEARANCE", "OVERALL_PROPORTION", "VISUAL_HIERARCHY"]
    },
    "concept": {
      "enum": ["VISUAL_WEIGHT", "SIMPLICITY", "STYLE_TEMPORALITY", "VISUAL_EMPHASIS", "PROPORTIONAL_CHARACTER", "STRUCTURAL_CHARACTER"]
    },
    "value": {
      "type": "string",
      "description": "One value from the concept's ordered continuum (see vocabulary.json) — never a millimeter number or an invented 0-100 score."
    },
    "strength": { "enum": ["OPTIONAL", "PREFERRED", "IMPORTANT", "REQUIRED"] },
    "priority": { "type": "integer" },
    "provenance": {
      "enum": ["USER_EXPLICIT", "USER_CONTEXT", "AI_NORMALIZED", "SYSTEM_PROFILE", "EXISTING_PROJECT", "CLARIFICATION_RESPONSE", "DERIVED_RELATION", "UNRESOLVED"]
    },
    "confidenceClass": {
      "enum": ["EXACT", "HIGH_CONFIDENCE_NORMALIZATION", "AMBIGUOUS", "INFERRED", "UNRESOLVED"]
    },
    "sourceText": { "type": "string" },
    "resolutionStatus": {
      "enum": ["UNRESOLVED", "PRESERVED", "DETERMINISTICALLY_RESOLVED", "USER_RESOLVED", "PROFILE_RESOLVED", "UNSUPPORTED", "CONFLICTING"]
    },
    "relatedJDLPaths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Always empty in v1 — no automatic subjective-to-numeric JDL mapping exists yet."
    },
    "diagnostics": { "type": "array", "items": { "type": "string" } }
  }
}
