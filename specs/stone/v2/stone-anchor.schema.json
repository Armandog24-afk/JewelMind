{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jewelmind.dev/specs/stone/v2/stone-anchor.schema.json",
  "title": "StoneAnchor",
  "description": "A deterministic named point on the stone outline, in local millimetres. A GEOMETRIC FACT only \u2014 never a prong position. The Setting System decides whether to put metal at an anchor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anchor",
    "x",
    "y"
  ],
  "properties": {
    "anchor": {
      "type": "string",
      "enum": [
        "CENTER",
        "TOP",
        "BOTTOM",
        "LEFT",
        "RIGHT",
        "TIP",
        "CLEFT",
        "LEFT_LOBE",
        "RIGHT_LOBE",
        "WIDE_END",
        "NARROW_END",
        "CORNER_NW",
        "CORNER_NE",
        "CORNER_SW",
        "CORNER_SE"
      ]
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    }
  }
}
