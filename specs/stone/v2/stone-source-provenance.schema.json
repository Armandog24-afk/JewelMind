{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jewelmind.dev/specs/stone/v2/stone-source-provenance.schema.json",
  "title": "StoneSourceProvenance",
  "description": "Where a stone's geometry came from. Deliberately free of wall-clock timestamps: this record participates in definitionHash and in Golden snapshots, and a clock reading would make identical geometry hash differently on every run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceMode",
    "normalizationOperations"
  ],
  "properties": {
    "sourceMode": {
      "$ref": "stone-source.schema.json"
    },
    "sourceAssetHash": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceAssetName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "originalUnit": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "mm",
        "cm",
        "m",
        "in",
        null
      ]
    },
    "normalizationOperations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generatorVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "importerVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "measurementSource": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "measurementDate": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "operatorNote": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    }
  }
}
