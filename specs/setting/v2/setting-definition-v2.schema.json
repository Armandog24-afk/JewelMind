{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jewelmind.dev/specs/setting/v2/setting-definition-v2.schema.json",
  "title": "SettingDefinition",
  "$defs": {
    "BezelSettingDefinition": {
      "additionalProperties": false,
      "description": "Bezel-family parameters (brief section 17).\n\n`wallThicknessMm` and `wallHeightMm` are PRELIMINARY SOFTWARE VALUES\nwhen defaulted — deliberate, configurable software choices, never\nprofessional recommendations (SETTING-GOV-010). See\ndocs/bible/21-setting/bezel-setting-contract.md.",
      "properties": {
        "wallThicknessMm": {
          "title": "Wallthicknessmm",
          "type": "number"
        },
        "wallHeightMm": {
          "title": "Wallheightmm",
          "type": "number"
        },
        "verticalReference": {
          "const": "GIRDLE",
          "default": "GIRDLE",
          "title": "Verticalreference",
          "type": "string"
        },
        "outlineOffsetMode": {
          "const": "CONSTANT_OFFSET",
          "default": "CONSTANT_OFFSET",
          "title": "Outlineoffsetmode",
          "type": "string"
        }
      },
      "required": [
        "wallThicknessMm",
        "wallHeightMm"
      ],
      "title": "BezelSettingDefinition",
      "type": "object"
    },
    "HeadSettingDefinition": {
      "additionalProperties": false,
      "description": "Head-family parameters: the structure between the attachment plane and\nthe stone (Sprint 23).\n\nEvery dimension here is a CONSTRUCTION PARAMETER. `wallThicknessMm` and\nthe taper ratios are deliberate software choices chosen to produce robust\ngeometry, exactly like the bezel's wall dimensions — never professional\nrecommendations, and no minimum is enforced because no sourced professional\nminimum exists (SETTING-GOV-010).",
      "properties": {
        "architecture": {
          "default": "BASKET",
          "enum": [
            "BASKET",
            "PEG_HEAD",
            "MARTINI",
            "TULIP"
          ],
          "title": "Architecture",
          "type": "string"
        },
        "outerRadiusMm": {
          "exclusiveMinimum": 0.0,
          "maximum": 100.0,
          "title": "Outerradiusmm",
          "type": "number"
        },
        "wallThicknessMm": {
          "exclusiveMinimum": 0.0,
          "maximum": 20.0,
          "title": "Wallthicknessmm",
          "type": "number"
        },
        "innerRadiusMm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Innerradiusmm"
        },
        "heightMm": {
          "exclusiveMinimum": 0.0,
          "maximum": 100.0,
          "title": "Heightmm",
          "type": "number"
        },
        "baseRadiusRatio": {
          "default": 0.55,
          "exclusiveMinimum": 0.05,
          "maximum": 1.0,
          "title": "Baseradiusratio",
          "type": "number"
        },
        "pegDiameterMm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 20.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pegdiametermm"
        },
        "pegHeightMm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 50.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pegheightmm"
        }
      },
      "required": [
        "outerRadiusMm",
        "wallThicknessMm",
        "heightMm"
      ],
      "title": "HeadSettingDefinition",
      "type": "object"
    },
    "ProngGroupSpec": {
      "additionalProperties": false,
      "description": "A named subset of prongs that share a style or a stone assignment.\n\nGrouping is how \"these two prongs are the shared pair between the centre\nand the left side stone\" is stated. It carries no geometry of its own — a\ngroup is a label over positions, so removing one changes nothing built.",
      "properties": {
        "groupId": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Groupid",
          "type": "string"
        },
        "style": {
          "anyOf": [
            {
              "enum": [
                "ROUND_PRONG",
                "CLAW_PRONG",
                "V_PRONG",
                "TAPERED_PRONG"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style"
        },
        "positionIndices": {
          "items": {
            "type": "integer"
          },
          "maxItems": 100,
          "title": "Positionindices",
          "type": "array"
        }
      },
      "required": [
        "groupId"
      ],
      "title": "ProngGroupSpec",
      "type": "object"
    },
    "ProngPositionSpec": {
      "additionalProperties": false,
      "description": "One explicitly placed prong, in the stone's own local millimetre frame.\n\nExists so a configuration no strategy derives is still expressible. The\n`servesStoneInstanceIds` field is what makes a SHARED prong a real concept\nrather than a coincidence of position: a prong between two stones declares\nboth, and that declaration survives into the geometry metadata where\ninspection and Vision can read it.",
      "properties": {
        "xMm": {
          "maximum": 100.0,
          "minimum": -100.0,
          "title": "Xmm",
          "type": "number"
        },
        "yMm": {
          "maximum": 100.0,
          "minimum": -100.0,
          "title": "Ymm",
          "type": "number"
        },
        "servesStoneInstanceIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Servesstoneinstanceids",
          "type": "array"
        }
      },
      "required": [
        "xMm",
        "yMm"
      ],
      "title": "ProngPositionSpec",
      "type": "object"
    },
    "ProngSettingDefinition": {
      "additionalProperties": false,
      "description": "Prong-family parameters (brief section 9). Mirrors the real public\nJDL fields; `placementStrategy` and `style` are Setting-internal and\nare resolved from the stone rather than requested via JDL.",
      "properties": {
        "prongCount": {
          "title": "Prongcount",
          "type": "integer"
        },
        "prongDiameterMm": {
          "title": "Prongdiametermm",
          "type": "number"
        },
        "prongHeightMm": {
          "title": "Prongheightmm",
          "type": "number"
        },
        "placementStrategy": {
          "enum": [
            "RADIAL",
            "OUTLINE_CARDINAL"
          ],
          "title": "Placementstrategy",
          "type": "string"
        },
        "style": {
          "default": "ROUND_PRONG",
          "enum": [
            "ROUND_PRONG",
            "CLAW_PRONG",
            "V_PRONG",
            "TAPERED_PRONG"
          ],
          "title": "Style",
          "type": "string"
        },
        "positionSource": {
          "default": "DERIVED",
          "enum": [
            "DERIVED",
            "EXPLICIT"
          ],
          "title": "Positionsource",
          "type": "string"
        },
        "positions": {
          "items": {
            "$ref": "#/$defs/ProngPositionSpec"
          },
          "maxItems": 100,
          "title": "Positions",
          "type": "array"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/ProngGroupSpec"
          },
          "maxItems": 20,
          "title": "Groups",
          "type": "array"
        },
        "tipRatio": {
          "default": 0.6,
          "exclusiveMinimum": 0.05,
          "maximum": 1.0,
          "title": "Tipratio",
          "type": "number"
        }
      },
      "required": [
        "prongCount",
        "prongDiameterMm",
        "prongHeightMm",
        "placementStrategy"
      ],
      "title": "ProngSettingDefinition",
      "type": "object"
    },
    "SeatSettingDefinition": {
      "additionalProperties": false,
      "description": "Whether and how metal is relieved where the stone sits (Sprint 23).",
      "properties": {
        "mode": {
          "default": "NONE",
          "enum": [
            "NONE",
            "REFERENCE_SEAT"
          ],
          "title": "Mode",
          "type": "string"
        },
        "clearanceMm": {
          "default": 0.02,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Clearancemm",
          "type": "number"
        }
      },
      "title": "SeatSettingDefinition",
      "type": "object"
    },
    "SettingAttachmentInterface": {
      "additionalProperties": false,
      "description": "The generic, category-neutral handoff between a Setting and whatever\nstructure incorporates it (brief section 21).\n\nA RingHead consumes this today; a future PendantBody or EarringBody\nconsumes the same contract. The Setting never learns which one it is\n(SETTING-GOV-014).",
      "properties": {
        "attachmentPlaneZMm": {
          "title": "Attachmentplanezmm",
          "type": "number"
        },
        "embedMm": {
          "title": "Embedmm",
          "type": "number"
        },
        "supportHeightMm": {
          "title": "Supportheightmm",
          "type": "number"
        }
      },
      "required": [
        "attachmentPlaneZMm",
        "embedMm",
        "supportHeightMm"
      ],
      "title": "SettingAttachmentInterface",
      "type": "object"
    },
    "StoneSettingReference": {
      "additionalProperties": false,
      "description": "The kernel-neutral facts a Setting is allowed to consume about one\nstone (brief section 20). Built by `stone_interface.py` from a real\ngenerated stone component — never by reaching into Stone builder\ninternals.\n\nA Setting may read these; it may never redefine stone geometry\n(SETTING-GOV-003).",
      "properties": {
        "stoneId": {
          "title": "Stoneid",
          "type": "string"
        },
        "shape": {
          "title": "Shape",
          "type": "string"
        },
        "lengthMm": {
          "title": "Lengthmm",
          "type": "number"
        },
        "widthMm": {
          "title": "Widthmm",
          "type": "number"
        },
        "depthMm": {
          "title": "Depthmm",
          "type": "number"
        },
        "orientationDeg": {
          "title": "Orientationdeg",
          "type": "number"
        },
        "girdlePlaneZMm": {
          "title": "Girdleplanezmm",
          "type": "number"
        },
        "centerXMm": {
          "title": "Centerxmm",
          "type": "number"
        },
        "centerYMm": {
          "title": "Centerymm",
          "type": "number"
        },
        "boundingBoxMinMm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Boundingboxminmm",
          "type": "array"
        },
        "boundingBoxMaxMm": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Boundingboxmaxmm",
          "type": "array"
        },
        "isBilaterallySymmetric": {
          "title": "Isbilaterallysymmetric",
          "type": "boolean"
        },
        "isRadiallySymmetric": {
          "default": false,
          "title": "Isradiallysymmetric",
          "type": "boolean"
        },
        "tipDirectionY": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tipdirectiony"
        },
        "outlinePoints": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outlinepoints"
        },
        "narrowWidthMm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narrowwidthmm"
        }
      },
      "required": [
        "stoneId",
        "shape",
        "lengthMm",
        "widthMm",
        "depthMm",
        "orientationDeg",
        "girdlePlaneZMm",
        "centerXMm",
        "centerYMm",
        "boundingBoxMinMm",
        "boundingBoxMaxMm",
        "isBilaterallySymmetric"
      ],
      "title": "StoneSettingReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What setting to build, for which stone, attached how.",
  "properties": {
    "settingId": {
      "title": "Settingid",
      "type": "string"
    },
    "settingType": {
      "enum": [
        "prong",
        "bezel"
      ],
      "title": "Settingtype",
      "type": "string"
    },
    "stone": {
      "$ref": "#/$defs/StoneSettingReference"
    },
    "attachment": {
      "$ref": "#/$defs/SettingAttachmentInterface"
    },
    "prong": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProngSettingDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "bezel": {
      "anyOf": [
        {
          "$ref": "#/$defs/BezelSettingDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "head": {
      "anyOf": [
        {
          "$ref": "#/$defs/HeadSettingDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "seat": {
      "anyOf": [
        {
          "$ref": "#/$defs/SeatSettingDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "settingId",
    "settingType",
    "stone",
    "attachment"
  ],
  "type": "object"
}
