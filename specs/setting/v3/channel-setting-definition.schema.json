{
  "additionalProperties": false,
  "description": "Channel-family parameters (Sprint 27).\n\nA channel is TWO PARALLEL WALLS with the stones between them. This model\ndescribes the walls; it never describes where the stones are — a channel\nspanning a row consumes placements the Stone Arrangement Engine resolved and\nrecords their ids, and computing a position here would be the second\nplacement engine ARRANGE-GOV-006 forbids.\n\nEvery dimension is a CONSTRUCTION PARAMETER. No minimum wall thickness is\nenforced, because no sourced professional minimum exists — the same\ndocumented gap the bezel already carries (SETTING-GOV-010).",
  "properties": {
    "axisDeg": {
      "default": 0.0,
      "maximum": 360.0,
      "minimum": -360.0,
      "title": "Axisdeg",
      "type": "number"
    },
    "spanMm": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 200.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Spanmm"
    },
    "innerWidthMm": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 100.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Innerwidthmm"
    },
    "wallThicknessMm": {
      "exclusiveMinimum": 0.0,
      "maximum": 20.0,
      "title": "Wallthicknessmm",
      "type": "number"
    },
    "wallHeightMm": {
      "exclusiveMinimum": 0.0,
      "maximum": 50.0,
      "title": "Wallheightmm",
      "type": "number"
    },
    "termination": {
      "default": "OPEN",
      "enum": [
        "OPEN",
        "CLOSED_ENDS"
      ],
      "title": "Termination",
      "type": "string"
    },
    "symmetry": {
      "default": "SYMMETRIC",
      "enum": [
        "SYMMETRIC",
        "ASYMMETRIC"
      ],
      "title": "Symmetry",
      "type": "string"
    },
    "offsetXMm": {
      "default": 0.0,
      "maximum": 50.0,
      "minimum": -50.0,
      "title": "Offsetxmm",
      "type": "number"
    },
    "offsetYMm": {
      "default": 0.0,
      "maximum": 50.0,
      "minimum": -50.0,
      "title": "Offsetymm",
      "type": "number"
    },
    "offsetZMm": {
      "default": 0.0,
      "maximum": 50.0,
      "minimum": -50.0,
      "title": "Offsetzmm",
      "type": "number"
    },
    "stoneInstanceIds": {
      "items": {
        "type": "string"
      },
      "maxItems": 120,
      "title": "Stoneinstanceids",
      "type": "array"
    }
  },
  "required": [
    "wallThicknessMm",
    "wallHeightMm"
  ],
  "title": "ChannelSettingDefinition",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jewelmind.dev/specs/setting/v3/channel-setting-definition.schema.json"
}
