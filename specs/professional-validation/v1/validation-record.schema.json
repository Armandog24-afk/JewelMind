{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jewelmind.example/specs/professional-validation/v1/validation-record.schema.json",
  "title": "Validation Record v1",
  "description": "The one artifact that can ever claim professional validation occurred — and only when isTemplate is false AND it lives in the active registry file (specs/professional-validation/v1/current-validation-registry.json), never an examples/fixtures directory. PROVAL-GOV-001/002/003. Sub-shapes inlined, not $ref'd. Mirrors backend/jewelmind/professional_validation/schemas.py::ValidationRecord. See docs/bible/15-professional-validation/412-validation-object-model.md and 418-validation-decision-model.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordId", "target", "reviewerId", "decision", "status", "rationale", "reviewDate"],
  "properties": {
    "recordId": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectType", "objectId", "version", "description"],
      "properties": {
        "objectType": {
          "enum": [
            "FORGE_RULE", "DOMAIN_STATEMENT", "GEOMETRY_COMPONENT", "GEOMETRY_RELATIONSHIP",
            "COMPLETE_MODEL", "MANUFACTURING_PROFILE", "MATERIAL_PROFILE", "SETTING_BEHAVIOUR",
            "EXPORT_WORKFLOW", "CAD_INTEROPERABILITY_WORKFLOW", "DESIGN_PROFILE"
          ]
        },
        "objectId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "implementationReferences": { "type": "array", "items": { "type": "string" } },
        "relatedTests": { "type": "array", "items": { "type": "string" } },
        "currentValidationStatus": {
          "enum": [
            "NOT_REVIEWED", "REVIEW_PLANNED", "UNDER_REVIEW", "INSUFFICIENT_EVIDENCE",
            "VALIDATED", "VALIDATED_WITH_CONDITIONS", "REJECTED", "REVALIDATION_REQUIRED", "SUPERSEDED"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jewelryCategory": { "type": ["string", "null"] },
        "ringStyle": { "type": ["string", "null"] },
        "component": { "type": ["string", "null"] },
        "material": { "type": ["string", "null"] },
        "alloy": { "type": ["string", "null"] },
        "manufacturingMethod": { "type": ["string", "null"] },
        "stoneShape": { "type": ["string", "null"] },
        "stoneDimensionRangeMm": { "type": ["string", "null"] },
        "settingType": { "type": ["string", "null"] },
        "sizeRange": { "type": ["string", "null"] },
        "cadApplication": { "type": ["string", "null"] },
        "exporterVersion": { "type": ["string", "null"] },
        "forgeRuleVersion": { "type": ["string", "null"] },
        "atlasVersion": { "type": ["string", "null"] },
        "jdlVersion": { "type": ["string", "null"] },
        "geographicOrWorkshopConstraints": { "type": ["string", "null"] }
      }
    },
    "reviewerId": {
      "type": "string",
      "description": "Empty only for an isTemplate:true record awaiting a real reviewer — the non-empty check for an active-registry record is a business rule enforced by validate-review-record, not this structural schema."
    },
    "sessionId": { "type": ["string", "null"] },
    "decision": {
      "enum": ["ACCEPTED", "ACCEPTED_WITH_CONDITIONS", "REJECTED", "INSUFFICIENT_EVIDENCE", "OUT_OF_SCOPE", "SUPERSEDED"]
    },
    "status": {
      "enum": [
        "NOT_REVIEWED", "REVIEW_PLANNED", "UNDER_REVIEW", "INSUFFICIENT_EVIDENCE",
        "VALIDATED", "VALIDATED_WITH_CONDITIONS", "REJECTED", "REVALIDATION_REQUIRED", "SUPERSEDED"
      ]
    },
    "evidenceIds": { "type": "array", "items": { "type": "string" } },
    "conditions": { "type": ["string", "null"] },
    "rationale": { "type": "string" },
    "reviewDate": { "type": "string" },
    "expirationOrReviewTrigger": { "type": ["string", "null"] },
    "supersedesRecordId": { "type": ["string", "null"] },
    "isTemplate": {
      "type": "boolean",
      "description": "Must be true for every example/fixture record and MUST NEVER be true for a record in the active registry — registry.py enforces this as a hard structural guard."
    }
  }
}
