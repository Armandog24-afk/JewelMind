{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jewelmind.example/specs/geometry-inspection/v2/inspection-diagnostic.schema.json",
  "title": "Inspection Diagnostic v2",
  "description": "One diagnostic entry from a runtime inspection — never implies geometry invalidity on its own; it means one specific inspection could not produce a fact. See docs/bible/16-geometry-inspection/483-inspection-error-model.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "severity", "message"],
  "properties": {
    "code": {
      "enum": [
        "INSPECTION_COMPONENT_MISSING", "INSPECTION_SHAPE_INVALID", "INSPECTION_VOLUME_FAILED",
        "INSPECTION_BOUNDING_BOX_FAILED", "INSPECTION_CONNECTIVITY_FAILED", "INSPECTION_INTERSECTION_FAILED",
        "INSPECTION_DISTANCE_FAILED", "INSPECTION_TOPOLOGY_FAILED", "INSPECTION_KERNEL_UNAVAILABLE",
        "INSPECTION_UNSUPPORTED", "INSPECTION_INTERNAL_ERROR"
      ]
    },
    "severity": { "enum": ["info", "warning", "error"] },
    "message": { "type": "string" },
    "componentIds": { "type": "array", "items": { "type": "string" } }
  }
}
