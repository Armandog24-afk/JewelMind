# Copy this file to .env and adjust as needed. docker-compose.yml reads
# these for local overrides; both services also work with no .env file at
# all, using the defaults baked into docker-compose.yml / the app code.

# Backend: comma-separated list of allowed browser origins (CORS).
JEWELMIND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend: base URL the browser uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:8000

# Backend: Designer v1 AI provider selection. Leave unset (the default) to
# run with no AI provider — Designer's "/api/designer/interpret" endpoint
# then returns DESIGNER_PROVIDER_UNAVAILABLE and the rest of the app
# (manual editing, generation, export) is entirely unaffected. The only
# currently-implemented real provider is "anthropic"; it also requires
# ANTHROPIC_API_KEY. Never commit a real key to this file or to .env.
DESIGNER_PROVIDER=
ANTHROPIC_API_KEY=
# Optional: overrides the default Claude model Designer's Anthropic
# provider calls (backend/jewelmind/designer/provider.py).
DESIGNER_ANTHROPIC_MODEL=
