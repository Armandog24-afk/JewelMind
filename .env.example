# Copy this file to .env and adjust as needed. docker-compose.yml reads
# these for local overrides; both services also work with no .env file at
# all, using the defaults baked into docker-compose.yml / the app code.

# Backend: comma-separated list of allowed browser origins (CORS).
JEWELMIND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend: base URL the browser uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:8000
